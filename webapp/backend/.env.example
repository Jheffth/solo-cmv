# Copie para .env e ajuste os valores. O .env nunca vai para o repositório.

# ============================================================================
# BANCO DE DADOS
# ============================================================================
# Desenvolvimento (arquivo local, nada a instalar):
DATABASE_URL=sqlite:///./solo_cmv.db

# Produção (PostgreSQL). Note o dialeto "+psycopg" — é o driver psycopg 3:
# DATABASE_URL=postgresql+psycopg://solo_cmv:SENHA@localhost:5432/solo_cmv
#
# Senha com caracteres especiais precisa ser codificada para URL:
#   @ vira %40   : vira %3A   / vira %2F   # vira %23
# Ou, mais simples, gere uma senha só com letras e números.

# ============================================================================
# SEGURANÇA
# ============================================================================
# A SECRET_KEY assina os tokens de sessão. Quem a tem escreve um token
# dizendo "sou o Arquiteto" e entra sem senha — por isso ela é mais sensível
# que qualquer senha, e por isso não existe valor de exemplo aqui: exemplo
# copiado é exemplo em produção.
#
# Gere a sua:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Com AMBIENTE=prod a aplicação RECUSA subir se esta chave estiver ausente,
# vazia, curta demais ou for um dos valores que já circularam publicamente.
# Em desenvolvimento pode deixar em branco: o sistema usa uma chave de
# brincadeira e não reclama.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================================================
# REDE
# ============================================================================
# Porta 8000 e 8080 são exclusivas do Solo Rotinas — não usar aqui.
PORT=8095
# 127.0.0.1 = só esta máquina. Atrás de nginx, mantenha 127.0.0.1: quem
# atende a internet é o nginx, e a aplicação não precisa ficar exposta.
HOST=127.0.0.1
# Os domínios que o navegador pode usar. Em produção, o domínio real:
CORS_ORIGINS=http://localhost:8095,http://127.0.0.1:8095
AMBIENTE=dev
